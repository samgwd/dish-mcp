# Optional if DISH_EMAIL and DISH_PASSWORD are set.
# The MCP will populate and refresh this automatically.
DISH_COOKIE=<YOUR_DISH_COOKIE>
TEAM_ID=<YOUR_TEAM_ID>
MEMBER_ID=<YOUR_MEMBER_ID>

# Optional: enable non-interactive cookie refresh.
# This only works if DiSH accepts direct email/password login for your account.
# DISH_EMAIL=you@example.com
# DISH_PASSWORD=<YOUR_PASSWORD>

# Optional: HTTP transport configuration
# MCP_TRANSPORT=http
# MCP_PORT=8000
# MCP_HOST=127.0.0.1
